## DeepSeek API Key（MCP_TRANSPORT=stdio 时必填：给本地 deepseek-mcp-server 用）
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

## MCP 连接方式：stdio（默认，本地子进程）| http（远程 Streamable HTTP）
# MCP_TRANSPORT=stdio

## 远程 MCP（MCP_TRANSPORT=http 时必填）：托管端点见 deepseek-mcp-server 文档
# DEEPSEEK_MCP_URL="https://deepseek-mcp.ragweld.com/mcp"
# DEEPSEEK_MCP_AUTH_TOKEN="YOUR_HOSTED_MCP_BEARER_TOKEN"

## 端口（可选）
PORT=3001

## 模型（可选，默认 deepseek-chat）
DEEPSEEK_MODEL="deepseek-chat"

## 归纳回合专用模型（可选，默认与 DEEPSEEK_MODEL 相同）
# DEEPSEEK_REFLECT_MODEL="deepseek-chat"

## 将 AI 归纳持久化到 Firestore（登录用户，永久记忆；不配置则仅用进程内存）
# FIRESTORE_REFLECT=true
## 二选一：服务账号 JSON 路径（相对 server 目录或绝对路径），或设置系统环境变量 GOOGLE_APPLICATION_CREDENTIALS
# FIREBASE_SERVICE_ACCOUNT_PATH=./your-service-account.json
## 单次 Firestore 读/写超时（毫秒），超时则回退进程内存，避免对话卡死（国内网络访问 Google 失败时常见）
# FIRESTORE_OP_TIMEOUT_MS=8000
## 每轮「归纳」调用 DeepSeek 的最长等待（毫秒），超时则跳过归纳，主回复仍会返回
# REFLECT_TIMEOUT_MS=25000

